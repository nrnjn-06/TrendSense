# ====================================================================
# TrendSense – Environment Configuration Template
# ====================================================================
# Copy this file to .env to configure your local development environment.
# Never commit the .env file with real credentials to version control.
#
# NOTE: All platform credentials below are OPTIONAL for Demo Mode.
# The application automatically runs in standalone Demo Mode with realistic
# multi-platform datasets if no credentials are provided.
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration (MySQL / Embedded H2 Fallback)
# --------------------------------------------------------------------
# TrendSense prioritizes connecting to your local MySQL 8 database.
# If MySQL is offline or not installed, the application automatically
# falls back to an embedded H2 database (in MySQL-compatibility mode)
# located at ./data/social_analytics with zero manual configuration.
DB_URL=jdbc:mysql://localhost:3306/social_analytics?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Fallback Database Settings (H2)
DB_FALLBACK_ENABLED=true
DB_FALLBACK_URL=jdbc:h2:./data/social_analytics;MODE=MySQL;DATABASE_TO_UPPER=false;AUTO_SERVER=TRUE
DB_FALLBACK_USERNAME=sa
DB_FALLBACK_PASSWORD=

# --------------------------------------------------------------------
# 2. X (Twitter) Developer Platform / API v2
# --------------------------------------------------------------------
# Portal: https://developer.twitter.com/en/portal/dashboard
# Flow: OAuth 2.0 Authorization Code with PKCE (RFC 7636)
# Required App Type: Confidential or Public Client with PKCE enabled
# Callback URL: http://localhost:8080/oauth/callback/x
# Scopes: tweet.read, users.read, offline.access
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_REDIRECT_URI=http://localhost:8080/oauth/callback/x
# Optional App-Only Bearer Token (for public read access):
X_BEARER_TOKEN=

# --------------------------------------------------------------------
# 3. Meta Developer / Instagram Graph API
# --------------------------------------------------------------------
# Portal: https://developers.facebook.com/apps/
# Prerequisites: Instagram Professional/Business account linked to a Facebook Page
# Scopes: instagram_basic, instagram_manage_insights, instagram_manage_comments
INSTAGRAM_CLIENT_ID=your_instagram_client_id_here
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:8080/oauth/callback/instagram
# Optional Direct Access Token (for developer testing):
INSTAGRAM_ACCESS_TOKEN=

# --------------------------------------------------------------------
# 4. Meta Developer / Facebook Pages API
# --------------------------------------------------------------------
# Portal: https://developers.facebook.com/apps/
# Prerequisites: Facebook Page Admin access with Pages API permissions
# Scopes: pages_show_list, pages_read_engagement, pages_read_user_content
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:8080/oauth/callback/facebook
# Optional Page Access Token:
FACEBOOK_PAGE_ACCESS_TOKEN=

# --------------------------------------------------------------------
# 5. LinkedIn Developer / Community Management API
# --------------------------------------------------------------------
# Portal: https://www.linkedin.com/developers/apps
# Prerequisites: Verified LinkedIn Page with Community Management API approval
# Scopes: r_organization_social, r_basicprofile, openid, email
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8080/oauth/callback/linkedin
# Optional Direct Access Token:
LINKEDIN_ACCESS_TOKEN=

# --------------------------------------------------------------------
# 6. Trend Scoring Engine Formula Weights (Optional custom tuning)
# --------------------------------------------------------------------
# Score = (w_m * Mention) + (w_e * Engagement) + (w_g * Growth) + (w_r * Recency)
# Sum of weights must equal 1.0 (0.25 + 0.35 + 0.25 + 0.15 = 1.00)
TREND_WEIGHT_MENTION=0.25
TREND_WEIGHT_ENGAGEMENT=0.35
TREND_WEIGHT_GROWTH=0.25
TREND_WEIGHT_RECENCY=0.15
